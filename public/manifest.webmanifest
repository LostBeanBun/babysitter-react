{
  "name": "宝宝日记",
  "short_name": "宝宝日记",
  "description": "免费、纯本地保存的宝宝喂养记录与统计工具",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f2f0ed",
  "theme_color": "#f2f0ed",
  "orientation": "portrait",
  "shortcuts": [
    {
      "name": "记录喂奶",
      "short_name": "喂奶",
      "description": "打开喂奶记录表单",
      "url": "/log?timer=feeding",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "记录睡眠",
      "short_name": "睡眠",
      "description": "打开睡眠记录表单",
      "url": "/log?timer=sleep",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "记录尿布",
      "short_name": "尿布",
      "description": "打开尿布记录表单",
      "url": "/log?timer=diaper",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "查看统计",
      "short_name": "统计",
      "description": "打开统计页",
      "url": "/stats",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
